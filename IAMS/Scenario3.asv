clc
close all
clear all

%% iperbole di fuga



%% iperbole d'arrivo

a_f = 1.066293 *1.496*1e8;
e_f = 0.315212;
i_f = 8.51*pi/180;
OM_f = 205.80*pi/180;
om_f = 172.04*pi/180;
m_a = 1.7518*1e11; % Kg
D_a = 0.55; % Km
v_inf2 = 3.0295;
m_s = 1.989*1e30 % Kg
G = 6.67259*1e-11 % N*m^2/Kg^2
mu_s = 132712440018 % Km^2/s^3
mu_a = G*m_a;
th = 3.2;

[rr,vv] = par2car(a_f,e_f,i_f,OM_f,om_f,th,mu_s);
r_c_s = norm(rr);

r_SOI = r_c_s *(m_a/m_s)^(2/5);

mu_m = mu_a;
v_inf = v_inf2;
r_m = D_a/2;
a_H = -mu_m/v_inf^2;
if a_H>0
    error('Semiasse maggiore > di 0');
end

r_PH_n_i = r_m + [0 500 1000 1500 2000];

for r_PH_n = r_PH_n_i
    r_oc_n = r_PH_n; 
    v_oc_n = sqrt(mu_m/r_oc_n);
    e_H_n = 1 - r_PH_n/a_H ;
 if e_H_n<1
    error('eccentricità < di 1');
 end   
v_fuga = sqrt((2*mu_m)/r_PH_n);
v_PH_n = sqrt(v_inf^2+v_fuga^2);
Delta_n = -a_h*sqrt(e_H_n^2-1);
Delta_v_n = abs(v_oc_n - v_PH_n);
end




